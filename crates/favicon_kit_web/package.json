{
  "name": "favicon-kit-web-smoke",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-dir static/pkg --out-name favicon_kit_web . -- --locked",
    "prepare:wasm-smoke": "node scripts/prepare-wasm-smoke.mjs",
    "serve": "http-server static -a 127.0.0.1 -p 4173 -c-1 --silent",
    "test:wasm-smoke": "npm run prepare:wasm-smoke && playwright test",
    "test:wasm-smoke:local": "npm run build:wasm && npm run test:wasm-smoke"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "http-server": "14.1.1"
  }
}
